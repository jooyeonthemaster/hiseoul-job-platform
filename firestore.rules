rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ════════════════════════════════════════════════════════════════
    //  프로덕션 보안 규칙
    //  설계 원칙:
    //   1) list(쿼리)는 규칙이 필터가 아니다 — 쿼리 제약이 규칙을 "증명"해야 통과.
    //      그래서 공개 목록은 read:if true 이거나, 클라이언트 쿼리에 where 제약이 있어야 함.
    //   2) 컬렉션 이름은 코드와 정확히 일치해야 함(대소문자/하이픈).
    //      실제 코드는 'jobInquiries'(camelCase), 'likes', 'notifications', 'crawled-jobs' 를 사용.
    //   3) 본인(owner)은 비공개/미승인 상태의 자기 문서를 읽을 수 있어야 함.
    // ════════════════════════════════════════════════════════════════

    // 관리자 판별 (user 문서가 없을 수도 있으므로 exists 가드)
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          request.auth.uid != null
          && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
          )
        );
    }

    // ---- 사용자 프로필: 전체 읽기, 본인/관리자만 수정 ----
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // ---- 구직자 프로필(소문자 jobseekers = 실제 컬렉션): 전체 읽기, 본인/관리자만 수정 ----
    match /jobseekers/{userId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // ---- 포트폴리오: 공개분은 누구나, 비공개분은 본인(owner)/관리자만 읽기 ----
    //  공개 목록 쿼리는 where('isPublic','==',true) 제약으로 isPublic 분기를 증명한다.
    match /portfolios/{portfolioId} {
      allow read: if isAdmin()
        || resource.data.isPublic == true
        || (request.auth != null
            && (request.auth.uid == resource.data.userId || request.auth.uid == portfolioId));
      allow create: if request.auth != null;
      allow update, delete: if isAdmin()
        || (request.auth != null
            && (request.auth.uid == resource.data.userId || request.auth.uid == portfolioId));
    }

    // ---- 기업 정보: 승인된 기업은 누구나, 미승인분은 본인(owner)/관리자만 읽기 ----
    //  본인 읽기 예외가 없으면 승인 대기 기업이 자기 문서/승인상태를 못 읽어 대시보드가 깨진다.
    //  공개 목록 쿼리는 where('approvalStatus','==','approved') 제약으로 승인 분기를 증명한다.
    match /employers/{employerId} {
      allow read: if isAdmin()
        || resource.data.approvalStatus == 'approved'
        || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if request.auth != null;
      allow update, delete: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.userId);
    }

    // ---- 채용 제안(camelCase jobInquiries = 실제 컬렉션) ----
    //  당사자(구직자/기업)만 읽기·수정. 생성은 기업이 본인 uid를 employerId로 기록.
    //  목록 쿼리는 where('employerId'|'jobSeekerId','==',uid) 제약으로 규칙을 증명한다.
    match /jobInquiries/{inquiryId} {
      allow read, update, delete: if isAdmin()
        || (request.auth != null
            && (request.auth.uid == resource.data.jobSeekerId
                || request.auth.uid == resource.data.employerId));
      allow create: if isAdmin()
        || (request.auth != null
            && request.auth.uid == request.resource.data.employerId);
    }

    // ---- 좋아요: likeId = `${employerId}_${portfolioId}` ----
    //  좋아요 수/상태 조회는 공개(read:true → 무제약·portfolioId·jobSeekerId·employerId 쿼리 모두 통과).
    //  생성/삭제는 해당 기업 본인만.
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isAdmin()
        || (request.auth != null && request.auth.uid == request.resource.data.employerId);
      allow delete: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.employerId);
    }

    // ---- 알림: 교차 사용자 생성 허용(기업→구직자, 시스템). 읽기/수정/삭제는 수신자만 ----
    match /notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.userId);
    }

    // ---- 크롤링 채용공고(공개 채용 목록): 누구나 읽기, 쓰기는 관리자 ----
    //  주의: /api 라우트는 서버에서 클라이언트 SDK(인증 null)로 접근 → 읽기는 read:true 로 통과하지만
    //        쓰기(updateDoc)는 규칙으로 안전 인가 불가. 서버 쓰기는 firebase-admin SDK 로 전환 필요.
    match /crawled-jobs/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- 관리자 전용 catch-all (그 외 모든 경로) ----
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
